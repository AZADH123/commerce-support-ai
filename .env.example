# --- DeepSeek provider (required for chat) ---
DEEPSEEK_API_KEY=
# Optional model override; the default is DeepSeek V4.1 Flash.
DEEPSEEK_MODEL=deepseek-flash

# --- PostgreSQL (local Docker Compose default, pgvector image) ---
# Leave unset to fall back to the legacy local SQLite file (support_agent_v2.db).
DATABASE_URL=postgresql+psycopg://support:support@localhost:5432/support

# --- OIDC (Keycloak) ---
OIDC_ISSUER=http://localhost:8080/realms/support
OIDC_AUDIENCE=commerce-support-web
OIDC_CLIENT_ID=commerce-support-web
# Realm role that grants reviewer (staff) access.
OIDC_REVIEWER_ROLE=reviewer

# --- Phase 2: payment execution ---
# local (deterministic demo) or stripe (test-mode sandbox).
PAYMENT_PROVIDER=local
# Required only for PAYMENT_PROVIDER=stripe (sk_test_...). Never commit.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (whsec_...) used to verify raw-body signatures.
STRIPE_WEBHOOK_SECRET=

# --- Phase 2: async workers ---
REDIS_URL=redis://localhost:6379/0

# --- Phase 2: notifications (Mailpit locally) ---
# memory (default, no external calls) or smtp.
EMAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SENDER=no-reply@commerce-support.local

# --- Phase 2: policy embeddings (configured separately from DeepSeek chat) ---
# hashing (offline, deterministic, 384-d) or openai (compatible /embeddings API).
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=384
# For EMBEDDING_PROVIDER=openai:
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
